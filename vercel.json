{
"version": 2,
"builds": [
{
"src": "server.js",
"use": "@vercel/node"
},
{
"src": "main.html",
"use": "@vercel/static"
},
{
"src": "main.css",
"use": "@vercel/static"
},
{
"src": "index.html",
"use": "@vercel/static"
}
],
"routes": [
{
"src": "/main.css",
"dest": "/main.css"
},
{
"src": "/index.html",
"dest": "/index.html"
},
{
"src": "/(.*)",
"dest": "server.js"
}
]
}
